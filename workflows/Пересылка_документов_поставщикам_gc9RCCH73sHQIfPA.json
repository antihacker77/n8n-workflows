    {
      "parameters": {
        "jsCode": "const rows = $('Get row(s) in sheet').all();\nconst emails = $('Email Trigger (IMAP)').all();\nlet results = [];\n\nfor (const email of emails) {\n  const subject = (email.json.subject || \"\").toLowerCase();\n  \n  const matchedRow = rows.find(row => {\n    const keyword = (row.json[\"Ключевые слова\"] || \"\").toLowerCase();\n    const words = keyword.split(' ').filter(w => w.length > 2);\n    return words.length > 0 && words.every(word => subject.includes(word));\n  });\n\n  if (matchedRow) {\n    // Собираем имена всех вложений\n    const binaryKeys = Object.keys(email.binary || {});\n    \n    results.push({\n      json: {\n        to_email: matchedRow.json[\"Почта\"],\n        subject: email.json.subject,\n        company: matchedRow.json[\"Ключевые слова\"],\n        attachmentNames: binaryKeys // массив ключей\n      },\n      binary: email.binary\n    });\n  }\n}\nreturn results;"
      },
