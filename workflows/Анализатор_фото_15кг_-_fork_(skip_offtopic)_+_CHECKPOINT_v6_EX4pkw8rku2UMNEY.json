      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nif (!Array.isArray(staticData.processedIds)) staticData.processedIds = [];\nif (staticData.skipUntilDelimiter === undefined) staticData.skipUntilDelimiter = false;\n\nconst item = $input.first();\nconst photoId = item.json.id ? String(item.json.id) : null;\nconst isDelimiter = item.json.text === 'true';\n\n// --- РАЗДЕЛИТЕЛЬ ---\nif (isDelimiter) {\n  if (staticData.skipUntilDelimiter && staticData.resumeDelimiterId === photoId) {\n    staticData.skipUntilDelimiter = false;\n  }\n  if (!staticData.skipUntilDelimiter) {\n    staticData.lastDelimiterId = photoId;\n  }\n  return [{\n    json: {\n      id: photoId,\n      text: 'true',\n      _isDelimiter: true,\n      _sessionId: photoId\n    },\n    binary: item.binary\n  }];\n}\n\n// --- ОБЫЧНОЕ ФОТО (пропускаем) ---\nif (staticData.skipUntilDelimiter) {\n  return [{\n    json: {\n      id: photoId,\n      text: 'skip',         // ← было 'true', теперь 'skip'\n      _checkpoint_skip: true,\n      _reason: 'before_last_delimiter'\n    },\n    binary: item.binary\n  }];\n}\n\nif (photoId && staticData.processedIds.includes(photoId)) {\n  return [{\n    json: {\n      id: photoId,\n      text: 'skip',         // ← было 'true', теперь 'skip'\n      _checkpoint_skip: true,\n      _reason: 'already_processed'\n    },\n    binary: item.binary\n  }];\n}\n\n// --- НОВОЕ ФОТО — на AI Agent ---\nreturn [{\n  json: {\n    id: photoId,\n    text: item.json.text,\n    _sessionId: staticData.lastDelimiterId || 'session_default'\n  },\n  binary: item.binary\n}];"
