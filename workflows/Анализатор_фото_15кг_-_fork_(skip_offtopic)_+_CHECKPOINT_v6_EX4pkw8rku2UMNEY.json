    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.currentCompany) staticData.currentCompany = {};\nif (!Array.isArray(staticData.processedIds)) staticData.processedIds = [];\n\n// Сохраняем id этого фото как обработанного\nconst photoId = $('Checkpoint1').item?.json?.id;\nif (photoId && !staticData.processedIds.includes(String(photoId))) {\n  staticData.processedIds.push(String(photoId));\n}\n\n// Парсим ответ агента\nconst raw = $input.first().json.output || '{}';\nlet result;\ntry {\n  result = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  return [{ json: { action: 'skip' } }];\n}\n\nif (!result || typeof result !== 'object') {\n  return [{ json: { action: 'skip' } }];\n}\n\nconst toStr = (v) => (typeof v === 'string' ? v : (v == null ? '' : String(v)));\nconst normalizeContacts = (s) => {\n  s = toStr(s).trim();\n  if (!s) return \"' \";\n  return s.startsWith(\"'\") ? s : (\"' \" + s);\n};\n\nconst company = toStr(result.company).trim();\nconst product = toStr(result.product).trim();\nconst contacts = normalizeContacts(result.contacts);\nconst qr = toStr(result.qr).trim();\nconst confidence = toStr(result.confidence).trim().toLowerCase();\n\nconst cleanedContacts = contacts.replace(/^\\'\\s*/, '');\nconst phoneRegex = /(?:\\+?\\d[\\d\\s().-]{5,}\\d)/;\nconst photoHasPhone = phoneRegex.test(cleanedContacts);\nconst photoHasQr = (qr === 'present') || (/\\bqr\\b/i.test(cleanedContacts));\n\n// Мержим в currentCompany — обновляем только если нашли лучшие данные\nconst cur = staticData.currentCompany;\nif (typeof cur.hasPhone !== 'boolean') cur.hasPhone = false;\n\n// Обновляем company и product если нашли или confidence=high\nif (company && (!cur.company || confidence === 'high')) cur.company = company;\nif (product && (!cur.product || confidence === 'high')) cur.product = product;\n\n// Контакты — приоритет телефона над QR\nif (photoHasPhone && !cur.hasPhone) {\n  cur.contacts = contacts;\n  cur.hasPhone = true;\n  cur.qr = 'null';\n  cur.qrImageBinary = null;\n} else if (!cur.hasPhone) {\n  if (photoHasQr) {\n    cur.contacts = \"' QR\";\n    cur.qr = 'present';\n    cur.qrImageBinary = $('Checkpoint1').item.binary?.data || cur.qrImageBinary || null;\n  } else if (cleanedContacts && cleanedContacts.length > 1 && (!cur.contacts || cur.contacts === \"' \")) {\n    cur.contacts = contacts;\n    if (!cur.qr) cur.qr = 'null';\n  }\n}\n\nstaticData.currentCompany = cur;\nreturn [{ json: { action: 'skip' } }];\n"
      },
