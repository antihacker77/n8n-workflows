    {
      "parameters": {
        "jsCode": "// Финализация группы при встрече разделителя\n// rowNumber инкрементируется здесь\nconst staticData = $getWorkflowStaticData('global');\nconst row = staticData.currentCompany || {};\nstaticData.currentCompany = {};\n\nif (!staticData.rowNumber) staticData.rowNumber = 1;\nif (!staticData.qrRowNumber) staticData.qrRowNumber = 1;\n\nconst contacts = (row.contacts || \"' \").toString();\nconst cleanedContacts = contacts.replace(/^'\\s*/, '');\nconst phoneRegex = /(?:\\+?\\d[\\d\\s().-]{5,}\\d)/;\nconst hasPhone = (row.hasPhone === true) || phoneRegex.test(cleanedContacts);\nconst hasQr = !!(row.qr && row.qr !== 'null');\n\nif (row.company || row.product || row.contacts || row.qr) {\n  const targetSheet = (!hasPhone && hasQr) ? 'qr_only' : 'main';\n  const rowNum = targetSheet === 'qr_only' ? staticData.qrRowNumber : staticData.rowNumber;\n\n  if (targetSheet === 'qr_only') {\n    staticData.qrRowNumber++;\n  } else {\n    staticData.rowNumber++;\n  }\n\n  const item = {\n    json: {\n      action: 'write',\n      targetSheet,\n      rowNumber: rowNum,\n      company: row.company || '',\n      product: row.product || '',\n      contacts: row.contacts || \"' \",\n      qr: (!hasPhone && hasQr) ? (row.qr || 'present') : 'null'\n    }\n  };\n\n  if (targetSheet === 'qr_only' && row.qrImageBinary) {\n    item.binary = { data: row.qrImageBinary };\n  }\n\n  return [item];\n}\n\nreturn [{ json: { action: 'skip' } }];\n"
      },
