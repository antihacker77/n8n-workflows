      {
        "parameters": {
          "jsCode": "// Получаем массив данных из входящего узла Merge\n// Судя по скриншоту, путь к данным: data.data\nconst projectArray = items[0].json.data;\n\n// Проверяем, что это действительно массив, чтобы не было ошибок\nif (!Array.isArray(projectArray)) {\n  return {\n    error: \"Данные не являются массивом или путь data.data неверный\",\n    receivedData: projectArray\n  };\n}\n\n// Превращаем массив объектов в читаемый список строк\nconst formattedList = projectArray.map(project => {\n  return `${project.name}, ID (GID): ${project.gid}`;\n}).join('\\n');\n\n// Возвращаем результат\nreturn {\n  project_string: formattedList,\n  total_project: projectArray.length\n};"
        },
