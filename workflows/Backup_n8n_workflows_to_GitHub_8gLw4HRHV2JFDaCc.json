    {
      "parameters": {
        "jsCode": "const workflow = $input.first().json;\n\n// Безопасное имя файла\nconst safeName = (workflow.name || 'unnamed')\n  .replace(/[/\\\\?%*:|\"<>]/g, '')\n  .replace(/\\s+/g, '_')\n  .trim();\n\nconst fileName = `${safeName}_${workflow.id}.json`;\nconst content = JSON.stringify(workflow, null, 2);\n\n// SHA1 без crypto модуля\nfunction sha1(buffer) {\n  function rotate(n, s) { return (n << s) | (n >>> (32 - s)); }\n  const bytes = Array.from(buffer);\n  const len = bytes.length;\n  const words = new Array(Math.ceil((len + 9) / 64) * 16).fill(0);\n  for (let i = 0; i < len; i++) words[i >> 2] |= bytes[i] << (24 - (i % 4) * 8);\n  words[len >> 2] |= 0x80 << (24 - (len % 4) * 8);\n  words[words.length - 1] = len * 8;\n  let [a0, b0, c0, d0, e0] = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0];\n  for (let i = 0; i < words.length; i += 16) {\n    let [a, b, c, d, e] = [a0, b0, c0, d0, e0];\n    const W = [];\n    for (let j = 0; j < 80; j++) {\n      W[j] = j < 16 ? (words[i + j] || 0) : rotate(W[j-3] ^ W[j-8] ^ W[j-14] ^ W[j-16], 1);\n      let f, k;\n      if (j < 20)      { f = (b & c) | (~b & d); k = 0x5A827999; }\n      else if (j < 40) { f = b ^ c ^ d;           k = 0x6ED9EBA1; }\n      else if (j < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDC; }\n      else             { f = b ^ c ^ d;           k = 0xCA62C1D6; }\n      const T = (rotate(a, 5) + f + e + k + W[j]) >>> 0;\n      [e, d, c, b, a] = [d, c, rotate(b, 30), a, T];\n    }\n    a0 = (a0 + a) >>> 0; b0 = (b0 + b) >>> 0;\n    c0 = (c0 + c) >>> 0; d0 = (d0 + d) >>> 0;\n    e0 = (e0 + e) >>> 0;\n  }\n  return [a0, b0, c0, d0, e0].map(h => h.toString(16).padStart(8, '0')).join('');\n}\n\nconst contentBuffer = Buffer.from(content, 'utf-8');\nconst header = `blob ${contentBuffer.length}\\0`;\nconst headerBuffer = Buffer.from(header, 'utf-8');\nconst combined = Buffer.concat([headerBuffer, contentBuffer]);\nconst localSha = sha1(combined);\n\nreturn [{\n  json: {\n    fileName,\n    content,\n    localSha,\n    workflowId: workflow.id,\n    workflowName: workflow.name,\n    updatedAt: workflow.updatedAt\n  }\n}];"
      },
