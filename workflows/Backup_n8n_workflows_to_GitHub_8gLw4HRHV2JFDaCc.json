      "parameters": {
        "jsCode": "// Файл существует на GitHub\n// Сравниваем SHA — если совпадает, контент не изменился\nconst fileInfo = $input.first().json;\nconst prepareNode = $('Prepare file').first().json;\n\nconst remoteSha = fileInfo.sha || null;\nconst localSha = prepareNode.localSha;\nconst changed = remoteSha !== localSha;\n\nreturn [{\n  json: {\n    fileName: prepareNode.fileName,\n    content: prepareNode.content,\n    workflowId: prepareNode.workflowId,\n    workflowName: prepareNode.workflowName,\n    updatedAt: prepareNode.updatedAt,\n    sha: remoteSha,\n    localSha,\n    changed,\n    isNew: false\n  }\n}];\n"
