    {
      "parameters": {
        "jsCode": "const groups = {};\n\nfor (const item of $input.all()) {\n  const rowNum = item.json['row_number'];\n  \n  if (!groups[rowNum]) {\n    groups[rowNum] = {\n      ...item.json,\n      '_foundPhones': [],\n      '_foundLinks': [],\n    };\n  }\n  \n  const phone = item.json['WhatsApp найденные'];\n  const link = item.json['WhatsApp ссылки'];\n  \n  if (phone && phone !== 'empty') {\n    if (!groups[rowNum]['_foundPhones'].includes(phone)) {\n      groups[rowNum]['_foundPhones'].push(phone);\n    }\n  }\n  \n  if (link && link !== 'empty') {\n    if (!groups[rowNum]['_foundLinks'].includes(link)) {\n      groups[rowNum]['_foundLinks'].push(link);\n    }\n  }\n}\n\nreturn Object.values(groups).map(group => {\n  const found = group['_foundPhones'];\n  return {\n    json: {\n      ...group,\n      'WhatsApp найденные': found.length > 0 ? found.join('; ') : 'empty',\n      'WhatsApp ссылки': group['_foundLinks'].length > 0 ? group['_foundLinks'].join(';\\n') : 'empty',\n      'WhatsApp найденные детали': found.length > 0 ? `Найдено: ${found.length}` : 'empty',\n      '_foundPhones': undefined,\n      '_foundLinks': undefined,\n    }\n  };\n});"
      },
