    {
      "parameters": {
        "jsCode": "const result = [];\n\nfor (const item of $input.all()) {\n  const phoneField = item.json['WhatsApp (кандидаты)'];\n  \n  // Если пусто или \"empty\" — пропускаем / возвращаем как есть\n  if (!phoneField || String(phoneField).trim().toLowerCase() === 'empty') {\n    result.push(item);\n    continue;\n  }\n  \n  // Разделяем по ; и переносу строки\n  const phones = String(phoneField)\n    .split(/[;\\n]+/)\n    .map(p => p.trim())\n    .filter(p => p.length > 0 && p.toLowerCase() !== 'empty');\n  \n  if (phones.length <= 1) {\n    result.push({\n      json: {\n        ...item.json,\n        'WhatsApp (кандидаты)': phones[0] || phoneField,\n      }\n    });\n  } else {\n    phones.forEach((phone, index) => {\n      result.push({\n        json: {\n          ...item.json,\n          'WhatsApp (кандидаты)': phone,\n          'WhatsApp все номера': phoneField,\n          'Индекс номера': index + 1,\n        }\n      });\n    });\n  }\n}\n\nreturn result;"
      },
