      "parameters": {
        "jsCode": "const checkResult = $('Check phone number is registered in WhatsApp.').first();\nconst ifItem = $('If').first();\n\nreturn [{\n  json: {\n    'row_number': ifItem.json['row_number'],\n    'WhatsApp (кандидаты)': ifItem.json['WhatsApp (кандидаты)'],\n    'numberExists': checkResult.json['numberExists'],\n    'WhatsApp найденные': checkResult.json['numberExists'] === true \n      ? ifItem.json['WhatsApp (кандидаты)'] \n      : 'false',\n  }\n}];"
