    {
      "parameters": {
        "jsCode": "const rows = $('Get supplier rows').all();\nconst emails = $('Email Trigger (IMAP)').all();\nconst supervisorEmail = 'swetlanka.28@mail.ru';\n\nfunction normalize(value) {\n  return String(value || '')\n    .toLowerCase()\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/[^\\p{L}\\p{N}@._-]+/gu, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction getEmailText(email) {\n  return [\n    email.json.subject || '',\n    email.json.textPlain || '',\n    email.json.textHtml || '',\n    email.json.snippet || '',\n    email.json.from?.text || ''\n  ].join(' ');\n}\n\nconst results = [];\n\nfor (const email of emails) {\n  const binaryKeys = Object.keys(email.binary || {});\n  if (!binaryKeys.length) continue;\n\n  const haystack = normalize(getEmailText(email));\n  if (!haystack) continue;\n\n  const matchedRow = rows.find((row) => {\n    const keywordRaw = row.json['Ключевые слова'] || '';\n    const keywordTokens = normalize(keywordRaw).split(' ').filter((w) => w.length > 2);\n    return keywordTokens.length > 0 && keywordTokens.every((token) => haystack.includes(token));\n  });\n\n  if (!matchedRow) continue;\n\n  const toEmail = String(matchedRow.json['Почта'] || '').trim();\n  if (!toEmail) continue;\n\n  results.push({\n    json: {\n      to_email: toEmail,\n      copy_email: supervisorEmail,\n      subject: email.json.subject || 'Документы',\n      company: matchedRow.json['Ключевые слова'] || '',\n      attachmentNames: binaryKeys,\n      source_from: email.json.from?.text || '',\n      source_date: email.json.date || '',\n      body_text: 'Добрый день, примите в работу документы.'\n    },\n    binary: email.binary\n  });\n}\n\nreturn results;"
      },
