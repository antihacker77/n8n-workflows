    {
      "parameters": {
        "jsCode": "// 1. Получаем данные\nconst sheetData = $item(0).$node[\"Get row(s) in sheet\"].json;\nlet browserData = $item(0).$node[\"HTTP Request\"].json.data;\n\nif (typeof browserData === 'string') {\n    try { browserData = JSON.parse(browserData); } catch (e) { browserData = []; }\n}\n\n// 2. Ищем ВАШ магазин \"1-МОЖНО\"\nconst myStore = browserData.find(s => s.name && s.name.toUpperCase().includes(\"1-МОЖНО\"));\nconst myPrice = myStore ? parseInt(myStore.price.replace(/[^0-9]/g, '')) : 0;\n\n// 3. РАЗДЕЛЯЕМ КОНКУРЕНТОВ\n// Те, кто ДЕШЕВЛЕ вас (Продавцы с низкими ценами)\nconst cheaperFound = browserData.filter(s => {\n    const sPrice = parseInt(s.price.replace(/[^0-9]/g, '')) || 0;\n    const isNotMe = s.name && !s.name.toUpperCase().includes(\"1-МОЖНО\");\n    return isNotMe && sPrice < myPrice && sPrice > 0;\n});\n\n// Те, кто ДОРОЖЕ вас (Продавцы с высокими ценами)\nconst expensiveFound = browserData.filter(s => {\n    const sPrice = parseInt(s.price.replace(/[^0-9]/g, '')) || 0;\n    const isNotMe = s.name && !s.name.toUpperCase().includes(\"1-МОЖНО\");\n    return isNotMe && sPrice > myPrice;\n});\n\n// 4. Формируем списки для ячеек\nconst lowPriceList = cheaperFound.map(p => `${p.name} (${p.price.replace(/\\s/g, '')})`).join(\", \");\nconst highPriceList = expensiveFound.map(p => `${p.name} (${p.price.replace(/\\s/g, '')})`).join(\", \");\n\n// 5. Находим минимальную цену на рынке\nconst allPrices = browserData.map(s => parseInt(s.price.replace(/[^0-9]/g, '')) || Infinity);\nconst marketMin = Math.min(...allPrices);\n\nreturn {\n  sku: sheetData[\"Артикул\"] || \"Нет SKU\",\n  name: sheetData[\"Наименование\"] || \"Товар с Kaspi\",\n  myPrice: myPrice,\n  marketMinPrice: marketMin === Infinity ? 0 : marketMin,\n  \n  // Данные для твоих новых ячеек\n  lowPrices: lowPriceList || \"Никого нет\", \n  highPrices: highPriceList || \"Никого нет\",\n  \n  countAhead: cheaperFound.length,\n  status: myPrice === 0 ? \"Вас нет в списке\" : (cheaperFound.length > 0 ? \"Нужно снижать\" : \"Ок\")\n};"
      },
