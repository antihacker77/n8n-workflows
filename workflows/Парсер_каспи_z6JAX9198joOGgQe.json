        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ detached: false, code: \"module.exports = async ({ page, context }) => { const { url } = context; try { await page.setUserAgent('Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36'); await page.goto(url, { waitUntil: 'load', timeout: 25000 }); await page.waitForSelector('table.sellers-table__self', { timeout: 5000 }).catch(() => {}); let allSellers = []; let hasNext = true; while (hasNext) { const sellers = await page.evaluate(() => { const rows = Array.from(document.querySelectorAll('table.sellers-table__self tbody tr')); return rows.map(row => { const cells = row.querySelectorAll('td.sellers-table__cell'); return { name: cells[0]?.innerText.trim().split('\\\\n')[0] || '', price: row.querySelector('.sellers-table__price-cell-text')?.innerText.trim() || '0' }; }).filter(s => s.name.length > 0); }); allSellers = allSellers.concat(sellers); const nextBtn = await page.evaluate(() => { const items = Array.from(document.querySelectorAll('li.pagination__el')); const last = items[items.length - 1]; return last && !last.classList.contains('_disabled') && last.innerText.trim() === 'Следующая' ? true : false; }); if (nextBtn) { await page.evaluate(() => { const items = Array.from(document.querySelectorAll('li.pagination__el')); items[items.length - 1].click(); }); await page.waitForTimeout(2500); await page.waitForSelector('table.sellers-table__self', { timeout: 5000 }).catch(() => {}); } else { hasNext = false; } } return { status: 'success', data: allSellers }; } catch (e) { return { status: 'error', data: [], error: e.message }; } };\", context: { url: $json['Ссылка Kaspi'] } }) }}",
        "options": {
