      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const incoming = $('Normalize Telegram payload').item.json;\nconst row = $json || {};\nconst existingBuffer = String(row['Buffer'] || '').trim();\nconst currentPart = String(incoming.message_text || '').trim();\nconst mergedBuffer = [existingBuffer, currentPart].filter(Boolean).join(' ').replace(/\\s+/g, ' ').trim();\nreturn {\n  json: {\n    'Chat ID': incoming.chat_id,\n    'Buffer': mergedBuffer,\n    'Pending Token': incoming.pending_token,\n    'Last Message At': incoming.timestamp,\n    'Sender Name': incoming.sender_name,\n    'Username': incoming.username,\n    'Last Reply': row['Last Reply'] || '',\n    'Updated At': $now\n  }\n};"
      },
