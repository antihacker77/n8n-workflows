      "parameters": {
        "jsCode": "// Получаем массив данных из входящего узла Merge\n// Судя по скриншоту, путь к данным: data.data\nconst staffArray = items[0].json.data;\n\n// Проверяем, что это действительно массив, чтобы не было ошибок\nif (!Array.isArray(staffArray)) {\n  return {\n    error: \"Данные не являются массивом или путь data.data неверный\",\n    receivedData: staffArray\n  };\n}\n\n// Превращаем массив объектов в читаемый список строк\nconst formattedList = staffArray.map(user => {\n  return `Имя: ${user.name}, ID (GID): ${user.gid}`;\n}).join('\\n');\n\n// Возвращаем результат\nreturn {\n  staff_string: formattedList,\n  total_staff: staffArray.length\n};"
      },
